APP_NAME="Roni Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite file at database/database.sqlite (created by `composer run setup`)
DB_CONNECTION=sqlite

# API only: no database tables needed for sessions, cache, or queues
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Origin of the React app (Vite dev server), used for CORS
FRONTEND_URL=http://localhost:5173

# Portfolio
GITHUB_USERNAME=MukhamadRoni
# Optional: a personal access token raises the GitHub API rate limit for `php artisan github:sync`
GITHUB_TOKEN=
CONTACT_EMAIL=mukhamadroni27@gmail.com
CONTACT_WHATSAPP=6283111735013
