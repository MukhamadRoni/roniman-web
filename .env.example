# Settings for docker-compose.yml. Copy to .env on the server and adjust.

# Public address of the site (no trailing slash).
APP_URL=https://example.com

# Host port for the site. Use 127.0.0.1:8080 when a reverse proxy (Caddy, Traefik, host nginx) handles HTTPS.
HTTP_PORT=80

# Leave empty to generate a key on first start (stored in the app-data volume).
APP_KEY=

# Optional: a GitHub personal access token raises the API rate limit for the daily github:sync.
GITHUB_USERNAME=MukhamadRoni
GITHUB_TOKEN=

CONTACT_EMAIL=mukhamadroni27@gmail.com
CONTACT_WHATSAPP=6283111735013

# Re-seed portfolio content from backend/database/data/*.json on every start.
SEED_ON_START=true

LOG_LEVEL=warning
